{
  "info": {
    "name": "LegalMind API",
    "description": "Complete API collection for LegalMind legal consultation system. This includes all endpoints with example requests and responses.\n\n**Features:**\n- Legal query with RAG (Retrieval-Augmented Generation)\n- Health checks\n- Confidence scoring\n- Rate limiting (20 req/min)\n- Response time: 10-15 seconds\n\n**Environment Variables:**\n- `base_url`: Your API base URL (e.g., http://localhost:3000 or https://legalmind-api.onrender.com)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345"
  },

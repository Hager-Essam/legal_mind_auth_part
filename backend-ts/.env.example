# ── App ──────────────────────────────────────────────────────────────────────
LEGALMIND_NODE_ENV=development
LEGALMIND_APP_NAME=LegalMind API TS
LEGALMIND_API_HOST=0.0.0.0
LEGALMIND_API_PORT=3000
# Comma-separated allowed origins. Leave empty to allow all (dev only).
LEGALMIND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication
# Required in production; use a cryptographically random value of at least 32 characters.
LEGALMIND_JWT_SECRET=
LEGALMIND_JWT_ACCESS_EXPIRES_IN=15m
LEGALMIND_REFRESH_TOKEN_DAYS=7
LEGALMIND_FRONTEND_URL=http://localhost:5173
LEGALMIND_REFRESH_COOKIE_SAME_SITE=lax

# Email. Console mode is for local development only.
LEGALMIND_EMAIL_MODE=console
LEGALMIND_EMAIL_FROM=
LEGALMIND_EMAIL_HOST=
LEGALMIND_EMAIL_PORT=587
LEGALMIND_EMAIL_SECURE=false
LEGALMIND_EMAIL_USER=
LEGALMIND_EMAIL_PASSWORD=

# Cloudflare R2 avatar storage. All five values are required to enable uploads.
# The public URL should expose only the intended public avatar bucket/domain.
# Create an R2 API token with Object Read & Write (and Edit if needed) on LEGALMIND_R2_BUCKET.
# Account ID: Cloudflare dashboard → R2 → Overview (not the public r2.dev subdomain).
LEGALMIND_R2_ACCOUNT_ID=
LEGALMIND_R2_ACCESS_KEY_ID=
LEGALMIND_R2_SECRET_ACCESS_KEY=
LEGALMIND_R2_BUCKET=
LEGALMIND_R2_PUBLIC_URL=

# ── Database ──────────────────────────────────────────────────────────────────
LEGALMIND_APP_URI=mongodb://localhost:27017
LEGALMIND_RAG_URI=mongodb://localhost:27017
LEGALMIND_APP_DB=legalmind_app
LEGALMIND_RAG_DB=legalmind_rag
LEGALMIND_MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
LEGALMIND_MONGO_CONNECT_TIMEOUT_MS=10000
LEGALMIND_MONGO_MAX_POOL_SIZE=10
LEGALMIND_MONGO_MIN_POOL_SIZE=0

# ── DashScope (Alibaba Cloud ModelStudio) ────────────────────────────────────
# Get your key at: https://dashscope.aliyuncs.com
LEGALMIND_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Comma-separated list for round-robin rotation (e.g. key1,key2,key3)
LEGALMIND_DASHSCOPE_API_KEYS=your-dashscope-api-key-here

# ── LLM ───────────────────────────────────────────────────────────────────────
LEGALMIND_LLM_MODEL=qwen-plus
LEGALMIND_LLM_MODEL_FALLBACK=qwen-turbo

# ── Embedding ─────────────────────────────────────────────────────────────────
LEGALMIND_EMBEDDING_MODEL=text-embedding-v4
LEGALMIND_EMBEDDING_DIM=1024

# ── Retrieval ─────────────────────────────────────────────────────────────────
LEGALMIND_RETRIEVAL_TOP_K=20
LEGALMIND_RETRIEVAL_OVERFETCH=20
LEGALMIND_RERANK_TOP_K=10

# ── Hybrid Search ─────────────────────────────────────────────────────────────
LEGALMIND_ENABLE_HYBRID_SEARCH=true
LEGALMIND_SPARSE_TOP_K=20
LEGALMIND_RRF_K=60

# ── Reranking ─────────────────────────────────────────────────────────────────
# Set to false to use the heuristic reranker (no API call, zero latency).
LEGALMIND_ENABLE_LLM_RERANK=true
LEGALMIND_LLM_RERANK_MODEL=qwen3-rerank

# ── Query Rewriting ───────────────────────────────────────────────────────────
LEGALMIND_ENABLE_AUTHORITY_HINTS=true

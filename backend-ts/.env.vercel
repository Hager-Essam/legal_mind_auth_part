# ⚠️ VERCEL ENVIRONMENT VARIABLES TEMPLATE
# Copy these variables to Vercel Dashboard → Settings → Environment Variables
# Replace placeholder values with your actual credentials

# ==============================================
# APPLICATION CONFIG
# ==============================================
LEGALMIND_NODE_ENV=production
LEGALMIND_APP_NAME=legalmind-backend-ts
LEGALMIND_API_HOST=0.0.0.0
LEGALMIND_API_PORT=5001

# ==============================================
# MONGODB DATABASE
# ==============================================
LEGALMIND_APP_MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
LEGALMIND_APP_MONGO_DB=legalmind_app
LEGALMIND_RAG_MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
LEGALMIND_RAG_MONGO_DB=legalmind_rag

# ==============================================
# JWT AUTHENTICATION
# ==============================================
LEGALMIND_JWT_SECRET=REPLACE_WITH_STRONG_SECRET_KEY_32_CHARS_MIN
LEGALMIND_JWT_ACCESS_EXPIRES_IN=15m
LEGALMIND_REFRESH_TOKEN_DAYS=7

# ==============================================
# CORS (⚠️ ADD YOUR VERCEL URLS HERE!)
# ==============================================
LEGALMIND_CORS_ORIGINS=https://legal-mind-front.vercel.app,https://YOUR-BACKEND-NAME.vercel.app

# ==============================================
# OPENAI API
# ==============================================
LEGALMIND_OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
LEGALMIND_LLM_MODEL=gpt-4o-mini
LEGALMIND_LLM_RERANK_MODEL=gpt-4o-mini
LEGALMIND_EMBEDDING_MODEL=text-embedding-3-large
LEGALMIND_EMBEDDING_DIMENSIONS=3072

# ==============================================
# QDRANT VECTOR DATABASE
# ==============================================
LEGALMIND_QDRANT_URL=https://REPLACE_WITH_YOUR_CLUSTER.cloud.qdrant.io
LEGALMIND_QDRANT_API_KEY=REPLACE_WITH_YOUR_KEY
LEGALMIND_QDRANT_LEGAL_COLLECTION=legal_chunks

# ==============================================
# CLOUDFLARE R2 STORAGE
# ==============================================
LEGALMIND_R2_ENDPOINT=https://REPLACE_WITH_YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
LEGALMIND_R2_ACCOUNT_ID=REPLACE_WITH_YOUR_ACCOUNT_ID
LEGALMIND_R2_ACCESS_KEY_ID=REPLACE_WITH_YOUR_ACCESS_KEY
LEGALMIND_R2_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET_KEY
LEGALMIND_R2_AVATARS_BUCKET=legalmind-avatars
LEGALMIND_R2_BLOG_IMAGES_BUCKET=legalmind-blog-images
LEGALMIND_R2_PUBLIC_URL=https://REPLACE_WITH_YOUR_PUBLIC_DOMAIN

# ==============================================
# SMTP EMAIL SERVICE
# ==============================================
LEGALMIND_SMTP_HOST=smtp.gmail.com
LEGALMIND_SMTP_PORT=587
LEGALMIND_SMTP_USER=REPLACE_WITH_YOUR_EMAIL@gmail.com
LEGALMIND_SMTP_PASS=REPLACE_WITH_YOUR_APP_PASSWORD
LEGALMIND_SMTP_FROM_NAME=LegalMind
LEGALMIND_SMTP_FROM_EMAIL=REPLACE_WITH_YOUR_EMAIL@gmail.com

# ==============================================
# STRIPE PAYMENTS
# ==============================================
LEGALMIND_STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_KEY
LEGALMIND_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_KEY
LEGALMIND_STRIPE_PRICE_ID_BASIC=price_REPLACE_WITH_YOUR_ID
LEGALMIND_STRIPE_PRICE_ID_STANDARD=price_REPLACE_WITH_YOUR_ID
LEGALMIND_STRIPE_PRICE_ID_PREMIUM=price_REPLACE_WITH_YOUR_ID

# ==============================================
# FEATURE FLAGS
# ==============================================
LEGALMIND_ENABLE_HYBRID_SEARCH=true
LEGALMIND_ENABLE_AUTHORITY_HINTS=true
LEGALMIND_ENABLE_LLM_RERANK=false

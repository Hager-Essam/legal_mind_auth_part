{
  "name": "legalmind-backend-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript and Express backend foundation for LegalMind.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "create-indexes": "tsx src/scripts/create-indexes.ts",
    "migrate": "tsx src/scripts/migrate-legal-structure.ts",
    "diagnose": "tsx src/scripts/diagnose-parent-child.ts",
    "evaluate": "tsx src/scripts/evaluate.ts",
    "view-db": "tsx src/scripts/view-database.ts",
    "serve-ui": "node serve-ui.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

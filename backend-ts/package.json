{
  "name": "legalmind-backend-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript and Express backend foundation for LegalMind.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "tunnel": "tsx src/scripts/start-tunnel.ts",
    "tunnel:ngrok": "npx ngrok http --url=bacteria-reforest-cupping.ngrok-free.dev 5001",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "create-indexes": "tsx src/scripts/create-indexes.ts",
    "evaluate": "tsx src/scripts/evaluate.ts",
    "test:auth": "tsx --test src/auth-tests/*.test.ts",
    "test:auth:unit": "tsx --test src/auth-tests/*.unit.test.ts",
    "test:auth:integration": "tsx --test src/auth-tests/*.integration.test.ts",
    "test:chat": "tsx --test src/chat-tests/*.test.ts",
    "test:blogs": "tsx --test src/blog-tests/*.test.ts",
    "test:query": "tsx --test src/query-tests/*.test.ts",
    "test:security": "tsx --test src/security-tests/*.test.ts",
    "test:contracts": "tsx --test src/contract-tests/*.test.ts",
    "migrate:auth": "tsx src/scripts/migrate-auth-storage.ts",
    "migrate:chat": "tsx src/scripts/migrate-chat-storage.ts",
    "migrate:legal-source-metadata": "tsx src/scripts/migrate-legal-source-metadata.ts",
    "indexes:app": "tsx src/scripts/setup-app-indexes.ts",
    "atlas:indexes": "tsx src/scripts/setup-atlas-search-indexes.ts",
    "audit:legal-corpus": "tsx src/scripts/audit-legal-corpus.ts",
    "migrate:verified-authority-statuses": "tsx src/scripts/apply-verified-authority-statuses.ts",
    "reembed:legal-chunks": "tsx src/scripts/reembed-legal-chunks.ts",
    "import:official-labor-law-2025": "tsx src/scripts/import-official-labor-law-2025.ts",
    "import:updated-social-procurement-laws": "tsx src/scripts/import-updated-social-procurement-laws.ts",
    "publish:legacy-legal-chunks": "tsx src/scripts/publish-legacy-legal-chunks.ts",
    "classify:legacy-authorities": "tsx src/scripts/classify-completed-legacy-authorities.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/lib-storage": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "html-pdf-node": "^1.0.7",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.3.0",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.49.0",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^4.0.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/html-pdf-node": "^1.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.1.2",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "untun": "^0.2.2"
  }
}

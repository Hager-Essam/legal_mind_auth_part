{
  "name": "legalmind-backend-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript and Express backend foundation for LegalMind.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "create-indexes": "tsx src/scripts/create-indexes.ts",
    "migrate": "tsx src/scripts/migrate-legal-structure.ts",
    "diagnose": "tsx src/scripts/diagnose-parent-child.ts",
    "evaluate": "tsx src/scripts/evaluate.ts",
    "view-db": "tsx src/scripts/view-database.ts",
    "serve-ui": "node serve-ui.js",
    "test:auth": "tsx --test src/auth-tests/*.test.ts",
    "test:auth:unit": "tsx --test src/auth-tests/*.unit.test.ts",
    "test:auth:integration": "tsx --test src/auth-tests/*.integration.test.ts",
    "test:chat": "tsx --test src/chat-tests/*.test.ts",
    "test:query": "tsx --test src/query-tests/*.test.ts",
    "test:security": "tsx --test src/security-tests/*.test.ts",
    "migrate:auth": "tsx src/scripts/migrate-auth-storage.ts",
    "migrate:chat": "tsx src/scripts/migrate-chat-storage.ts",
    "migrate:legal-source-metadata": "tsx src/scripts/migrate-legal-source-metadata.ts",
    "indexes:app": "tsx src/scripts/setup-app-indexes.ts",
    "atlas:indexes": "tsx src/scripts/setup-atlas-search-indexes.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

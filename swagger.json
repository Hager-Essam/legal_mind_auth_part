        ],
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "معرّف العقد"
          }
        ],
        "responses": {
          "200": {
            "description": "اتصال SSE مفتوح"
          },
          "401": {
            "description": "غير مصرح - يجب تسجيل الدخول"
          },
          "404": {
            "description": "لم يتم العثور على العقد"
          }
        }
      }
    },
    "/api/analyze/{jobId}/report/download": {
      "get": {
        "summary": "تحميل التقرير",
        "description": "تحميل تقرير التحليل كملف Markdown.",
        "tags": [
          "Contract Analysis"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "معرّف العقد"
          }
        ],
        "responses": {
          "200": {
            "description": "تم تحميل التقرير بنجاح",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "العقد لم يتم تحليله بعد"
          },
          "401": {
            "description": "غير مصرح - يجب تسجيل الدخول"
          },
          "404": {
            "description": "لم يتم العثور على العقد أو نتائج التحليل"
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "summary": "جلب جميع العقود (مسار بديل)",
        "description": "مسار بديل لجلب جميع العقود.",
        "tags": [
          "Contract Analysis"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "تم جلب العقود بنجاح"
          },
          "401": {
            "description": "غير مصرح - يجب تسجيل الدخول"
          }
        }
      }
    }
  }
}
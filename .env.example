# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority&appName=Cluster0
DB_NAME=legalmind

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=5001
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=*

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=LegalMind <noreply@legalmind.com>

# Client URL
CLIENT_URL=http://localhost:3000

# Contract Analyzer Configuration
OPENAI_API_KEY=your-openai-api-key
BASE_URL=https://your-openai-base-url/compatible-mode/v1
QDRANT_URL=https://your-qdrant-url
QDRANT_API_KEY=your-qdrant-api-key

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=legal-mind-contracts
R2_PUBLIC_URL=https://your-custom-domain.com # Optional: Custom domain for public access
